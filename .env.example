# Copy to .env next to docker-compose.yml on the VPS (chmod 600). Never commit .env.
APP_ENV=staging
DOMAIN=bookclub-staging.ogun.se
# Generate on the server: openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs sessions. Generate on the server: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Resend API key with "Sending access" to mail.ogun.se only.
RESEND_API_KEY=
# Google OAuth web client (Google Cloud console > Google Auth Platform > Clients). The ID is public.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Books API key restricted to the Books API (ISBN lookups). Optional: without it, Open Library only.
GOOGLE_BOOKS_API_KEY=
# Who reviews reported notes (comma-separated; must be confirmed accounts). They get an email when a note is hidden.
ADMIN_EMAILS=
