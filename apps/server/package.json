{
  "name": "@bookclub/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=dev.env --env-file-if-exists=.env --watch --watch-preserve-output --import tsx src/index.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/server.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "preview": "node --env-file=preview.env --enable-source-maps dist/server.mjs"
  },
  "dependencies": {
    "@bookclub/shared": "*",
    "@hono/node-server": "^2.1.4",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
